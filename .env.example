# PostgreSQL 連線（libpq 連線字串，與 docker-compose.yml 的設定一致）
DATABASE_URL=postgresql://phishing:phishing@localhost:5432/phishing

# Flask
HOST=127.0.0.1
PORT=5001
FLASK_DEBUG=0

# IPQualityScore（寄件者帳號信譽查詢）
# 這是範例檔，會進版控：請勿在此填真正的金鑰。
# 真正的金鑰複製到 .env（已被 .gitignore 忽略）再填。留著 placeholder 時系統會自動略過 IPQS。
IPQS_API_KEY=your_ipqs_api_key_here
